# Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# External PostgreSQL / Supabase Connection (Optional)
# Leave blank to run 100% offline using the local transactional file store (data/utsavgrid-db.json).
# To connect an external free-tier Supabase PostgreSQL database, run db/postgres_schema.sql
# in your Supabase SQL Editor and set DATABASE_URL below.
DATABASE_URL=""

# Razorpay India / UPI Configuration (Optional — falls back to Offline UPI Sandbox when unset)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
